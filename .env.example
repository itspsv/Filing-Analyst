# Copy this file to .env and fill in your own values. .env is git-ignored.

# The SEC requires a User-Agent with your name and email, or it returns 403.
SEC_USER_AGENT="Your Name your.email@example.com"

# Groq API key from https://console.groq.com/keys (LLM_API_KEY also works).
GROQ_API_KEY="your-groq-key"

# Optional overrides, for example to switch to a backup provider:
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="openai/gpt-oss-120b"
# LLM_TOKENS_PER_MINUTE=8000
# LLM_DAILY_TOKEN_LIMIT=190000
